<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: nothing is backed up (allowBackup="false" already turns backup off;
     this replaces the rules cunning_document_scanner's manifest would otherwise merge in). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
